# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/dist/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Trained weights and checkpoints (large binaries)
#
# Anchored to the repository root on purpose: an unanchored "models/" also
# matches apexgpt/models/ and silently keeps the model layer out of the repo.
/models/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz

# Downloaded and tokenized datasets
# Anchored for the same reason - apexgpt/features/data/ is source.
/data/
*.txt.gz
/corpus*.txt
/wiki_corpus.txt

# Logs and runtime output
*.log
*.err
/data_prep.log
/train.log
/logs/
/runs/
/out/

# Generated plots
loss_curves.png

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/
.ipynb_checkpoints

# Kilo
.kilo/

# Environment overrides
.env
.env.*

# Never ignore source. These two directories are named like the artifacts
# above, and a slice that git quietly refuses to track is a slice that is
# missing from the GitHub clone.
!apexgpt/features/data/
!apexgpt/models/
